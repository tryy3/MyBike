# Auth (required for server)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# First-boot seeds for DB-backed runtime settings (remove after Admin owns them):
# BETTER_AUTH_URL=http://localhost:3001
# CLIENT_URL=http://localhost:5173
# After running migrations, a bootstrap admin is seeded as admin@example.com / admin123.
# Change its password or delete it after promoting a real admin.
# Runtime config secret encryption (required before storing DB-backed secrets)
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Database (local Turso Database file by default)
# DB_PATH=server/data/mybike.db
# First-boot seed for server.port (remove after Admin owns it):
# PORT=3001
#
# Turso Cloud (remote-only). When BOTH are set, the server ignores DB_PATH and
# connects over the network via @tursodatabase/serverless.
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=
#
# One-time import of an existing local file into Turso Cloud (CLI):
#   turso db create mybike --from-file ./server/data/mybike.db
# Then set TURSO_DATABASE_URL / TURSO_AUTH_TOKEN from `turso db show` / `turso db tokens create`.
# Prefer a group token (`turso group tokens create <group>`) so PR branches only
# need a new TURSO_DATABASE_URL. Create a branch (prints export lines, no .env write):
#   npm run db:branch
#   npm run db:branch -- --from mybike --name mybike-dev-custom
# Default name: mybike-dev-<git-short-sha>. Source default: TURSO_BRANCH_FROM or mybike.
#
# Alternatively, keep DB_PATH (or SQLITE_IMPORT_PATH) pointing at the old local file
# while using Turso Cloud — the server copies bike/domain data once on startup and
# records a marker so it never runs again.
# SQLITE_IMPORT_PATH=server/data/mybike.db

# ---------------------------------------------------------------------------
# Runtime settings (MyBike server) — first-boot seeds only
# Settings → Admin → Configuration (/settings/admin/configuration)
# If the app_settings row is missing, a non-empty env value is written once.
# After seed, remove these from .env; leftover env is ignored with a warning.
# See: docs/admin-runtime-config-migration.md
# ---------------------------------------------------------------------------
#
# Server → server.port
#   PORT=3001
#
# Auth / client URLs → betterAuth.baseUrl, client.url
#   BETTER_AUTH_URL=http://localhost:3001
#   CLIENT_URL=http://localhost:5173
#
# Logging → logging.level, logging.toFile, logging.filePath, logging.redact
#   LOG_LEVEL=info
#   LOG_TO_FILE=true
#   LOG_FILE_PATH=
#   LOG_REDACT=true
#
# GraphQL → graphql.timing
#   GRAPHQL_TIMING=false
#
# Strava webhook client (MyBike → proxy) → strava.webhook.*
#   STRAVA_WEBHOOK_PROXY_URL=
#   STRAVA_WEBHOOK_PROXY_API_KEY=
#   STRAVA_SUBSCRIPTION_ID=
#   STRAVA_WEBHOOK_POLL_INTERVAL_MS=60000
#
# tsidp login → oauth.providers.tsidp.* (enable in Admin; not seeded)
#   TSIDP_CLIENT_ID=
#   TSIDP_CLIENT_SECRET=
#   TSIDP_ISSUER=
#   TSIDP_SCOPES=openid profile email
#
# Strava login + sync credentials → oauth.providers.strava.* / integration.strava.*
# (enabled flags are Admin-only; shared STRAVA_* may seed both oauth and integration rows)
#   STRAVA_CLIENT_ID=
#   STRAVA_CLIENT_SECRET=
#   STRAVA_REDIRECT_URI=http://localhost:3001/api/strava/callback
#   STRAVA_SCOPES=read,activity:read_all,profile:read_all

# ---------------------------------------------------------------------------
# strava-webhook-proxy process — stays in .env on the PROXY host (not MyBike admin)
# ---------------------------------------------------------------------------
# STRAVA_WEBHOOK_PROXY_PORT=3002
# STRAVA_WEBHOOK_PROXY_DB_PATH=strava-webhook-proxy/data/strava-webhook-proxy.db
# Prefer Turso Cloud for the proxy when BOTH are set (remote-only; ignores local path):
# STRAVA_WEBHOOK_PROXY_TURSO_DATABASE_URL=libsql://your-proxy-db-org.turso.io
# STRAVA_WEBHOOK_PROXY_TURSO_AUTH_TOKEN=
# STRAVA_WEBHOOK_PROXY_API_KEY=
# STRAVA_VERIFY_TOKEN=
# STRAVA_WEBHOOK_CALLBACK_URL=https://your-proxy.example.com/webhook/strava
#
# Strava login/sign-up callback (register in Strava app settings):
#   {betterAuth.baseUrl}/api/auth/callback/strava
# Strava sync callback (configure in Admin → Integration · Strava → Redirect URI):
#   http://localhost:3001/api/strava/callback
